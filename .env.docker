# ============================================================
# SecureVault Docker Environment Configuration
# ============================================================

# Database (MongoDB URI - Cloud Atlas)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=Cluster0"

# Application Encryption Key (32 bytes)
ENCRYPTION_KEY="your_32_character_encryption_key_here"

# JWT Secrets & Expiry
JWT_SECRET="generate_a_strong_64_character_random_hex_string_here"
ADMIN_JWT_SECRET="generate_a_strong_admin_64_character_random_hex_string_here"
ACCESS_TOKEN_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=7

# Email Settings (Gmail App Password)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your_gmail_app_password"

# Twilio SMS / Voice Credentials
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_FLOW_SID="your_twilio_flow_sid"
TWILIO_PHONE_NUMBER="+1234567890"

# Google OAuth Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Frontend / Backend URLs
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Environment Mode & Workflows
NODE_ENV="production"
INACTIVITY_TEST_MODE=true
COOLING_PERIOD_DAYS=0

