      "item": [
        {
          "name": "Public Ping Probes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "health"]
            }
          }
        },
        {
          "name": "Deep Subsystem Health Telemetry",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/system/health/deep",
